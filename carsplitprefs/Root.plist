<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>CarSplit</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>上屏能力</string>
			<key>footerText</key>
			<string>开启后，未做 CarPlay 适配的 App 也会出现在车机的应用列表中。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>全部应用上屏</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>allapps_carplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.userspace.carsplit.settings.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>双应用（v0.1 自动启动 / v0.2 并排分屏）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>App A（手机上运行）</string>
			<key>detail</key>
			<string>CarSplitAppPickerController</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>appA</string>
			<key>PostNotification</key>
			<string>com.userspace.carsplit.settings.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>App B（车机上运行）</string>
			<key>detail</key>
			<string>CarSplitAppPickerController</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>appB</string>
			<key>PostNotification</key>
			<string>com.userspace.carsplit.settings.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>CarPlay 连接后自动启动</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>autostart</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.userspace.carsplit.settings.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>分屏预览（v0.2）</string>
			<key>footerText</key>
			<string>无需连接车机，可在手机屏上测试双面板容器与分隔条；App 实时画面桥接在 v0.3。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>允许分屏预览</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>preview_enabled</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>立即显示分屏预览</string>
			<key>action</key>
			<string>showSplitPreview</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>关闭分屏预览</string>
			<key>action</key>
			<string>hideSplitPreview</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>CarPlay 连接后自动显示分屏</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>split_autostart</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.userspace.carsplit.settings.changed</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>分隔比例</string>
			<key>footerText</key>
			<string>拖动分屏预览中的分隔条即可调整，比例自动保存。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>分隔比例</string>
			<key>defaults</key>
			<string>com.userspace.carsplit</string>
			<key>key</key>
			<string>splitRatio</string>
			<key>default</key>
			<real>0.5</real>
			<key>min</key>
			<real>0.3</real>
			<key>max</key>
			<real>0.7</real>
		</dict>
	</array>
</dict>
</plist>
